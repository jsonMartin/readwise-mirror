{
  "compilerOptions": {
    "baseUrl": "src",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2021",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node10",
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "es2021", "scripthost"],
    "resolveJsonModule": true,
     "types": [
      "node"
    ],
  },
  "include": ["src/**/*.ts"]
}
